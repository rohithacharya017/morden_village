# =============================================================================
# Google Cloud Platform & CCAI Outbound SMS Configuration
# =============================================================================

# Your GCP Project ID (from Google Cloud Console)
GCP_PROJECT_ID=your-gcp-project-id

# GCP Region where your CCAI Platform instance is deployed (e.g., us-central1, asia-south1)
GCP_REGION=us-central1

# Contact Center AI Platform instance ID (defaults to 'default-contact-center')
CCAI_INSTANCE_ID=default-contact-center

# Outbound sender number or short code registered with your CCAI Platform SMS carrier
CCAI_SMS_SENDER_NUMBER=+18005550199

# (Optional) Direct path to service account key file if not using `gcloud auth application-default login`
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account-key.json
